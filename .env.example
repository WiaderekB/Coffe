# Opcjonalny ekran logowania w aplikacji (sesja cookie, także w PWA). Ustaw oba pola lub pozostaw oba puste.
APP_USERNAME=
APP_PASSWORD=

# Opcjonalne API agentów /api/v1. Osobny losowy sekret (min. 32 znaki). Puste = API wyłączone.
# Wygeneruj: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
APP_API_TOKEN=
